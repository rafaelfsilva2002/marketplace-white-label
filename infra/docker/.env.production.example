# ═══════════════════════════════════════════════════════════════════
# Marketplace AI-Native — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file to .env.production and fill in all values:
#   cp .env.production.example .env.production
#
# Then run with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d
#
# IMPORTANT: Never commit .env.production to version control!
# ═══════════════════════════════════════════════════════════════════

# ─── General ─────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=warn

# ─── Public URLs ─────────────────────────────────────────────────
# The public-facing URL of the site (used by Next.js for links, OG tags, etc.)
PUBLIC_SITE_URL=https://your-domain.com

# The public API URL (used by the frontend to call the backend)
PUBLIC_API_URL=https://your-domain.com/api/v1

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://your-domain.com

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=marketplace

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ─── JWT / Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand

# ─── Stripe (Payments) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─── AI Gateway ─────────────────────────────────────────────────
# Default provider: openai | anthropic | ollama
AI_GATEWAY_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-CHANGE_ME

# Anthropic
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Ollama (only if using local models)
# OLLAMA_BASE_URL=http://ollama:11434

# ─── Workers ────────────────────────────────────────────────────
# Number of concurrent BullMQ worker threads
WORKER_CONCURRENCY=5

# ─── SSL / Domain ───────────────────────────────────────────────
# Place your SSL certificates in ./certs/:
#   fullchain.pem — full certificate chain
#   privkey.pem   — private key
#
# For Let's Encrypt, use certbot:
#   certbot certonly --webroot -w /var/www/certbot -d your-domain.com

# ─── Optional: Email (for notifications) ────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@your-domain.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=noreply@your-domain.com

# ─── Optional: S3-Compatible Storage (for uploads) ──────────────
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=marketplace-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME

# ─── Optional: Monitoring ───────────────────────────────────────
# SENTRY_DSN=https://CHANGE_ME@sentry.io/123
# DATADOG_API_KEY=CHANGE_ME
